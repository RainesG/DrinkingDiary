{
  "usingComponents": {
    "van-icon": "@vant/weapp/icon/index",
    "van-button": "@vant/weapp/button/index",
    "list-card": "/components/list-card/index"
  },
  "resolveAlias": {
    "@/*": "/*"
  },
  "pages": [
    "pages/page-recipe/index",
    "pages/page-diary/index",
    "pages/page-map/index"
  ],
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#fff",
    "navigationBarTitleText": "Drinking Diary",
    "navigationBarTextStyle": "black"
  },
  "sitemapLocation": "sitemap.json",
  "tabBar": {
    "color": "#000",
    "selectedColor": "#000",
    "backgroundColor": "#fff",
    "position": "bottom",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/page-recipe/index",
        "text": "配方",
        "iconPath": "./images/recipe.png",
        "selectedIconPath": "./images/recipe.png"
      },
      {
        "pagePath": "pages/page-diary/index",
        "text": "日记"
      },
      {
        "pagePath": "pages/page-map/index",
        "text": "地图"
      }
    ]
  }
}