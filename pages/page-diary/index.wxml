<!--index.wxml-->
<view class="container">
	<!-- Quick Select Drinks -->
	<view class="record-list">
		<van-button data-index="{{ index }}" bindtap="onQuickAdd">添加</van-button>
		<block wx:for="{{ records }}" wx:key="id">
			<list-card>
				<text class="drink-label">{{item.name}}</text>
				<!-- <image class="drink-image" src="{{ item.thumb }}" mode="aspectFill" /> -->
				<view class="amount-controls">
					<van-button data-index="{{ index }}" bindtap="onMinus">
						<van-icon name="minus" />
					</van-button>
					<input class="amount-input" type="number" value="{{ item.amount }}" data-index="{{ index }}" bindinput="onAmountInput" />
					<van-button data-index="{{ index }}" bindtap="onAdd">
						<van-icon name="plus" />
					</van-button>
				</view>
			</list-card>
		</block>
	</view>
	<!-- Custom Entry -->
	<view class="custom-entry-title">自定义饮品</view>
	<drinking-entry bindsave="onCustomSave" />
	<!-- Summary Card -->
	<view class="summary-card">
		<view class="summary-row">
			<text>今日饮品总量：</text>
			<text class="summary-value">{{summary.totalAmount}} ml</text>
		</view>
		<view class="summary-row">
			<text>酒精摄入量：</text>
			<text class="summary-value">{{summary.totalAlcohol}} ml</text>
		</view>
		<view class="summary-row">
			<text class="summary-rating">{{summary.rating}}</text>
		</view>
	</view>
</view>
