<!--index.wxml-->
<view class="container">
  <view class="search-bar">
    <input
      type="text"
      placeholder="Search cocktail by name"
      value="{{ searchValue }}"
      bindinput="onInputChange"
      confirm-type="search"
      bindconfirm="getCocktailByName"
    />
    <button bindtap="getCocktailByName" size="mini">Search</button>
  </view>
  <view class="title">Eiusmod esse aute.</view>
  <view class="subtitle">Velit anim adipisicing.</view>
  <view class="decor-icons">🍸 🎲 🍋</view>
  <view wx:if="{{ cocktails.length }}">
    <block wx:for="{{ cocktails }}" wx:key="idDrink" wx:for-item="cocktail">
      <view class="cocktail-item">
        <image src="{{ cocktail.strDrinkThumb }}" mode="aspectFill" />
        <text>{{cocktail.strDrink}}</text>
      </view>
    </block>
  </view>

<view wx:if="{{drinkInfo.idDrink}}" class="cocktail-detail-card">
  <!-- Cocktail Name and Category -->
  <view class="cocktail-header">
    <text class="cocktail-name">{{drinkInfo.strDrink}}</text>
    <text class="cocktail-category">{{drinkInfo.strCategory}}</text>
    <text wx:if="{{drinkInfo.strIBA}}" class="cocktail-iba">IBA: {{drinkInfo.strIBA}}</text>
  </view>

  <!-- Glass and Picture -->
  <view class="cocktail-glass-pic">
    <image class="cocktail-pic" src="{{drinkInfo.strDrinkThumb}}" mode="aspectFill" />
    <text class="cocktail-glass">{{drinkInfo.strGlass}}</text>
  </view>

  <!-- Ingredients and Measures -->
  <view class="cocktail-ingredients">
    <view class="ingredients-title">Ingredients</view>
    <block wx:for="{{ingredients}}" wx:key="index" wx:for-item="name">
      <view class="ingredient-row">
        <text class="ingredient-measure">{{name}}</text>
      </view>
    </block>
  </view>

  <!-- Instructions -->
  <view class="cocktail-instructions">
    <view class="instructions-title">Instructions</view>
    <text>{{drinkInfo.strInstructions}}</text>
  </view>

  <!-- Tags -->
  <view wx:if="{{drinkInfo.strTags}}" class="cocktail-tags">
    <text class="tag-title">Tags:</text>
      <text class="cocktail-tag">{{drinkInfo.strTags}}</text>
  </view>
</view>
</view>
